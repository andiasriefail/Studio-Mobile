<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_root" android:layout_width="wrap_content" android:layout_height="match_parent"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="4dp">
        <ImageView android:id="@+id/tab_icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" />
        <TextView android:id="@+id/tab_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="middle" android:maxWidth="160dp" android:singleLine="true"
            android:textSize="15sp" />
        <ImageView android:id="@+id/tab_close" android:layout_width="40dp" android:layout_height="40dp" android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"
            android:src="@drawable/ic_close" android:contentDescription="@null" />
    </LinearLayout>
    <View android:id="@+id/tab_underline" android:layout_width="match_parent" android:layout_height="3dp" android:background="@color/cosmic_pink" />
</LinearLayout>
