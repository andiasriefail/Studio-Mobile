<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">
        <ImageView
            android:id="@+id/mcp_back"
            style="@style/Cosmic.IconButton"
            android:src="@drawable/ic_back"
            android:tint="@color/cosmic_ink"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/Cosmic.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/mcp_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Cosmic.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mcp_intro" />

            <!-- 1. The user's own relay URL and connection state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mcp_relay_title"
                    android:textColor="@color/cosmic_ink"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/mcp_relay_url"
                    style="@style/Cosmic.Input"
                    android:layout_marginTop="12dp"
                    android:autofillHints="url"
                    android:hint="@string/mcp_relay_url_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <TextView
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mcp_relay_help" />
                <EditText
                    android:id="@+id/mcp_relay_token"
                    style="@style/Cosmic.Input"
                    android:layout_marginTop="12dp"
                    android:autofillHints="password"
                    android:hint="@string/mcp_relay_token_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
                <TextView
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mcp_relay_token_help" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mcp_connection"
                        android:textColor="@color/cosmic_ink"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/mcp_connection_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/mcp_connection_none"
                        android:textColor="@color/cosmic_muted"
                        android:textSize="16sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mcp_status_detail"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/mcp_relay_toggle"
                        style="@style/Cosmic.Button.Primary"
                        android:text="@string/mcp_connect" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. The address the user pastes into the AI (built from the relay URL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mcp_endpoint_title"
                    android:textColor="@color/cosmic_ink"
                    android:textSize="18sp" />
                <TextView
                    android:id="@+id/mcp_endpoint_text"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mcp_endpoint_empty"
                    android:textIsSelectable="true" />
                <LinearLayout
                    android:id="@+id/mcp_endpoint_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/mcp_endpoint_copy"
                        style="@style/Cosmic.Button.Outline"
                        android:text="@string/mcp_endpoint_copy" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Read-only switch (the AI is told the limits by the server itself, nothing to show here) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mcp_read_only"
                        android:textColor="@color/cosmic_ink"
                        android:textSize="18sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mcp_read_only_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp"
                    android:text="@string/mcp_read_only_hint" />
            </LinearLayout>

            <!-- 4. Step by step guides -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mcp_guide_title"
                    android:textColor="@color/cosmic_ink"
                    android:textSize="18sp" />

                <!-- Claude -->
                <LinearLayout
                    android:id="@+id/mcp_guide_claude_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mcp_guide_claude"
                        android:textColor="@color/cosmic_primary_dark"
                        android:textSize="17sp" />
                    <ImageView
                        android:id="@+id/mcp_guide_claude_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/cosmic_muted"
                        android:contentDescription="@null" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mcp_guide_claude_body"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cosmic_lilac_soft" />

                <!-- ChatGPT -->
                <LinearLayout
                    android:id="@+id/mcp_guide_chatgpt_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mcp_guide_chatgpt"
                        android:textColor="@color/cosmic_primary_dark"
                        android:textSize="17sp" />
                    <ImageView
                        android:id="@+id/mcp_guide_chatgpt_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/cosmic_muted"
                        android:contentDescription="@null" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mcp_guide_chatgpt_body"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cosmic_lilac_soft" />

                <!-- Gemini -->
                <LinearLayout
                    android:id="@+id/mcp_guide_gemini_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mcp_guide_gemini"
                        android:textColor="@color/cosmic_primary_dark"
                        android:textSize="17sp" />
                    <ImageView
                        android:id="@+id/mcp_guide_gemini_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/cosmic_muted"
                        android:contentDescription="@null" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mcp_guide_gemini_body"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cosmic_lilac_soft" />

                <!-- Claude Code and other clients -->
                <LinearLayout
                    android:id="@+id/mcp_guide_code_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mcp_guide_code"
                        android:textColor="@color/cosmic_primary_dark"
                        android:textSize="17sp" />
                    <ImageView
                        android:id="@+id/mcp_guide_code_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/cosmic_muted"
                        android:contentDescription="@null" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mcp_guide_code_body"
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <TextView
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/mcp_keep_alive" />
                <TextView
                    style="@style/Cosmic.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mcp_security_note" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mcp_self_test"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="20dp">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_tonal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play"
                        android:tint="@color/cosmic_primary_dark"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/mcp_self_test"
                    android:textColor="@color/cosmic_ink"
                    android:textSize="18sp" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/cosmic_muted"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mcp_toolchain_status"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="20dp">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_tonal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/cosmic_primary_dark"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/mcp_toolchain_status"
                    android:textColor="@color/cosmic_ink"
                    android:textSize="18sp" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/cosmic_muted"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
