{
  "jdk": {
    "repo": "andiasriefail/nlauncher-jre-android-multi",
    "tag": "jre-bundle-r1",
    "assetPattern": "jre{major}-android-{arch}.tar.xz",
    "topDirPattern": "jre-{major}",
    "abis": {
      "arm64-v8a": "arm64",
      "armeabi-v7a": "arm"
    },
    "majors": [
      11,
      17,
      21,
      25,
      27
    ],
    "verifiedMajors": [
      21
    ],
    "bundledMajors": "all",
    "launcherTools": [
      "java",
      "javac",
      "jmod",
      "jar",
      "jlink"
    ]
  },
  "gradle": {
    "versions": [
      "8.13",
      "9.5.0",
      "9.8.1"
    ],
    "requiredVersions": [
      "9.8.1"
    ],
    "urlPattern": "https://services.gradle.org/distributions/gradle-{version}-bin.zip"
  }
}
