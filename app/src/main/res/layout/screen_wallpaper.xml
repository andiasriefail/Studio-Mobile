<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">
        <ImageView
            android:id="@+id/wallpaper_back"
            style="@style/Cosmic.IconButton"
            android:src="@drawable/ic_back"
            android:tint="@color/cosmic_ink"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/Cosmic.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wallpaper_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Live preview of the editor: picture, darkness and a little sample code. -->
            <FrameLayout
                android:id="@+id/wallpaper_preview_card"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_wallpaper_preview">
                <ImageView
                    android:id="@+id/wallpaper_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null" />
                <View
                    android:id="@+id/wallpaper_preview_shade"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/wallpaper_sample"
                    android:textColor="@color/night_text"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/wallpaper_preview_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:paddingBottom="16dp"
                    android:text="@string/wallpaper_none"
                    android:textColor="@color/night_muted"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/wallpaper_dim_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/cosmic_ink"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <SeekBar
                android:id="@+id/wallpaper_dim_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />
            <TextView
                style="@style/Cosmic.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_dim_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/wallpaper_choose"
                    style="@style/Cosmic.Button.Primary"
                    android:layout_marginEnd="6dp"
                    android:text="@string/wallpaper_choose" />
                <TextView
                    android:id="@+id/wallpaper_remove"
                    style="@style/Cosmic.Button.Outline"
                    android:layout_marginStart="6dp"
                    android:text="@string/wallpaper_remove" />
            </LinearLayout>

            <!-- Live wallpaper: a short video behind the code editor. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/wallpaper_video_title"
                android:textColor="@color/cosmic_ink"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                style="@style/Cosmic.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallpaper_video_hint" />
            <TextView
                android:id="@+id/wallpaper_video_status"
                style="@style/Cosmic.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wallpaper_video_active"
                android:textColor="@color/cosmic_primary_dark"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/wallpaper_choose_video"
                    style="@style/Cosmic.Button.Primary"
                    android:text="@string/wallpaper_choose_video" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
