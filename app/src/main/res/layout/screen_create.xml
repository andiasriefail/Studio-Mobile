<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cosmic_white" android:orientation="vertical">

    <LinearLayout android:id="@+id/screen_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <ImageView android:id="@+id/wizard_back_icon" style="@style/Cosmic.IconButton" android:src="@drawable/ic_back"
            android:tint="@color/cosmic_ink" android:contentDescription="@string/back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/wizard_title" style="@style/Cosmic.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/wizard_step" style="@style/Cosmic.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="24dp" android:paddingEnd="24dp">
        <View android:id="@+id/wizard_bar_1" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:layout_marginStart="0dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_step_bar_off" />
        <View android:id="@+id/wizard_bar_2" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_step_bar_off" />
        <View android:id="@+id/wizard_bar_3" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_step_bar_off" />
        <View android:id="@+id/wizard_bar_4" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="0dp" android:background="@drawable/bg_step_bar_off" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <ScrollView android:id="@+id/wizard_page_1" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal"
                android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="16dp">
                <FrameLayout android:layout_width="176dp" android:layout_height="176dp" android:background="@drawable/bg_dashed_icon">
                    <ImageView android:id="@+id/icon_preview" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"
                        android:src="@drawable/ic_image_upload" android:tint="@color/cosmic_primary" android:contentDescription="@null" />
                </FrameLayout>
                <LinearLayout android:id="@+id/btn_choose_icon" android:layout_width="wrap_content" android:layout_height="56dp"
                    android:layout_marginTop="20dp" android:background="@drawable/bg_button_primary" android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal"
                    android:paddingStart="28dp" android:paddingEnd="28dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload"
                        android:tint="@android:color/white" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:text="@string/choose_image" android:textColor="@android:color/white" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:text="@string/icon_note" style="@style/Cosmic.Muted" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="18dp" android:paddingEnd="18dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder"
                    android:tint="@color/cosmic_primary" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="16dp" android:text="mipmap-mdpi" android:textColor="@color/cosmic_ink" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="48 px" android:textColor="@color/cosmic_muted" android:textSize="15sp" />
                <ImageView android:id="@+id/icon_status_1" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginStart="12dp" android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="18dp" android:paddingEnd="18dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder"
                    android:tint="@color/cosmic_primary" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="16dp" android:text="mipmap-hdpi" android:textColor="@color/cosmic_ink" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="72 px" android:textColor="@color/cosmic_muted" android:textSize="15sp" />
                <ImageView android:id="@+id/icon_status_2" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginStart="12dp" android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="18dp" android:paddingEnd="18dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder"
                    android:tint="@color/cosmic_primary" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="16dp" android:text="mipmap-xhdpi" android:textColor="@color/cosmic_ink" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="96 px" android:textColor="@color/cosmic_muted" android:textSize="15sp" />
                <ImageView android:id="@+id/icon_status_3" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginStart="12dp" android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="18dp" android:paddingEnd="18dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder"
                    android:tint="@color/cosmic_primary" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="16dp" android:text="mipmap-xxhdpi" android:textColor="@color/cosmic_ink" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="144 px" android:textColor="@color/cosmic_muted" android:textSize="15sp" />
                <ImageView android:id="@+id/icon_status_4" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginStart="12dp" android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/wizard_page_2" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="@string/label_project_name" style="@style/Cosmic.Muted" />
                <EditText android:id="@+id/input_project" style="@style/Cosmic.Input" android:autofillHints="@null"
                    android:hint="@string/hint_project_name" android:inputType="textNoSuggestions" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"
                    android:text="@string/label_app_name" style="@style/Cosmic.Muted" />
                <EditText android:id="@+id/input_app" style="@style/Cosmic.Input" android:autofillHints="@null"
                    android:hint="@string/hint_app_name" android:inputType="text" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"
                    android:text="@string/label_package_name" style="@style/Cosmic.Muted" />
                <EditText android:id="@+id/input_package" style="@style/Cosmic.Input" android:autofillHints="@null"
                    android:hint="@string/hint_package_name" android:inputType="textNoSuggestions|textEmailAddress" />
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/wizard_page_3" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="@string/label_version_name" style="@style/Cosmic.Muted" />
                <EditText android:id="@+id/input_version_name" style="@style/Cosmic.Input" android:autofillHints="@null"
                    android:text="1.0" android:inputType="textNoSuggestions" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:text="@string/label_version_code" style="@style/Cosmic.Muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <ImageView android:id="@+id/version_code_minus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_remove" android:contentDescription="@null" />
            <TextView android:id="@+id/version_code_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="1" android:textColor="@color/cosmic_ink" android:textSize="20sp" />
            <ImageView android:id="@+id/version_code_plus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_add" android:contentDescription="@null" />
        </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/wizard_page_4" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:text="@string/label_min_sdk" style="@style/Cosmic.Muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <ImageView android:id="@+id/min_sdk_minus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_remove" android:contentDescription="@null" />
            <TextView android:id="@+id/min_sdk_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="23 · Android 6.0" android:textColor="@color/cosmic_ink" android:textSize="20sp" />
            <ImageView android:id="@+id/min_sdk_plus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_add" android:contentDescription="@null" />
        </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:text="@string/label_target_sdk" style="@style/Cosmic.Muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <ImageView android:id="@+id/target_sdk_minus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_remove" android:contentDescription="@null" />
            <TextView android:id="@+id/target_sdk_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="36 · Android 16" android:textColor="@color/cosmic_ink" android:textSize="20sp" />
            <ImageView android:id="@+id/target_sdk_plus" style="@style/Cosmic.Stepper" android:src="@drawable/ic_add" android:contentDescription="@null" />
        </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:background="@drawable/bg_summary" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/summary" android:textColor="@color/cosmic_ink" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/summary_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:textColor="@color/cosmic_ink" android:textSize="15sp" />
                    <TextView android:id="@+id/summary_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="@color/cosmic_ink" android:textSize="15sp" />
                    <TextView android:id="@+id/summary_sdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="@color/cosmic_ink" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cosmic_lilac" />
    <LinearLayout android:id="@+id/wizard_bottom" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="24dp">
        <TextView android:id="@+id/btn_back" style="@style/Cosmic.Button.Outline" android:layout_marginEnd="8dp" android:text="@string/back" />
        <TextView android:id="@+id/btn_next" style="@style/Cosmic.Button.Primary" android:layout_marginStart="8dp" android:text="@string/next" />
        <TextView android:id="@+id/btn_create" style="@style/Cosmic.Button.Primary" android:layout_marginStart="8dp" android:visibility="gone"
            android:drawableStart="@drawable/ic_check" android:drawablePadding="10dp" android:drawableTint="@android:color/white"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/create_project" />
    </LinearLayout>
</LinearLayout>
