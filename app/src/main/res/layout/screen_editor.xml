<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_drawer" android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_screen_night" android:orientation="vertical">

        <LinearLayout android:id="@+id/screen_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/night_bar" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/editor_menu" style="@style/Cosmic.IconButton" android:layout_width="40dp" android:padding="8dp" android:src="@drawable/ic_menu"
                android:tint="@color/night_text" android:contentDescription="@string/open_structure" />
            <LinearLayout android:id="@+id/editor_preview" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginStart="4dp" android:background="@drawable/bg_button_tonal" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_preview"
                    android:tint="@color/cosmic_primary_dark" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:text="@string/preview" android:textColor="@color/cosmic_primary_dark" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:id="@+id/editor_wrap" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:background="@drawable/bg_icon_circle_night" android:src="@drawable/ic_wrap" android:tint="@color/night_text"
                android:clickable="true" android:focusable="true" android:visibility="gone" android:contentDescription="@null" />
            <ImageView android:id="@+id/editor_save" style="@style/Cosmic.IconButton" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:src="@drawable/ic_save" android:tint="@color/night_text" android:visibility="gone" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/editor_build" android:layout_width="wrap_content" android:layout_height="48dp"
                android:background="@drawable/bg_button_pink" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_play"
                    android:tint="@color/cosmic_ink" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:text="@string/build" android:textColor="@color/cosmic_ink" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <ImageView android:id="@+id/editor_debug" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="4dp"
                android:padding="8dp" android:background="@drawable/bg_button_tonal" android:src="@drawable/ic_bug"
                android:tint="@color/cosmic_primary_dark" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/debug_mode_menu" />
        </LinearLayout>

        <!-- Browser-style tabs (max 5 files). The strip scrolls horizontally on its own, outside the code ScrollView, so swiping never fights the editor. -->
        <HorizontalScrollView android:id="@+id/editor_tab_bar" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@color/night_tab" android:fillViewport="true" android:overScrollMode="never"
            android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:id="@+id/tab_strip" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

            <!-- User wallpaper (Settings > Change Wallpaper) with a dark shade over it so code stays readable. -->
            <ImageView android:id="@+id/editor_wallpaper" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="@null" />
            <View android:id="@+id/editor_wallpaper_shade" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

            <LinearLayout android:id="@+id/editor_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_file_open" android:textColor="@color/night_text" android:textSize="22sp" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:gravity="center" android:text="@string/no_file_hint" android:textColor="@color/night_muted" android:textSize="16sp" />
                <LinearLayout android:id="@+id/editor_open_structure" android:layout_width="wrap_content" android:layout_height="56dp"
                    android:layout_marginTop="24dp" android:background="@drawable/bg_button_pink" android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal"
                    android:paddingStart="28dp" android:paddingEnd="28dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_menu"
                        android:tint="@color/cosmic_ink" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:text="@string/open_structure" android:textColor="@color/cosmic_ink" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView android:id="@+id/editor_code_area" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/code_gutter" android:layout_width="44dp" android:layout_height="wrap_content"
                        android:gravity="end" android:includeFontPadding="false" android:paddingTop="16dp" android:paddingEnd="8dp" android:paddingStart="0dp"
                        android:fontFamily="monospace" android:lineSpacingExtra="4dp" android:textColor="@color/code_gutter" android:textSize="14sp" />
                    <FrameLayout android:id="@+id/code_holder" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <HorizontalScrollView android:id="@+id/code_hscroll" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:fillViewport="true" android:scrollbars="none">
                            <EditText android:id="@+id/code_editor" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:autofillHints="@null" android:background="@null" android:gravity="top|start"
                                android:imeOptions="flagNoExtractUi" android:includeFontPadding="false" android:inputType="textMultiLine|textNoSuggestions"
                                android:fontFamily="monospace" android:lineSpacingExtra="4dp" android:paddingStart="8dp" android:paddingEnd="16dp"
                                android:paddingTop="16dp" android:paddingBottom="48dp" android:textColor="@color/night_text"
                                android:textColorHighlight="#556F5CE6" android:textSize="14sp" />
                        </HorizontalScrollView>
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/editor_drawer_panel" android:layout_width="300dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="@color/cosmic_white" android:clickable="true" android:focusable="true" android:orientation="vertical">

        <LinearLayout android:id="@+id/drawer_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_cosmic_drawer_header" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_avatar_header">
                <TextView android:id="@+id/drawer_initials" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textColor="#A83A7A" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/drawer_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textColor="@android:color/white" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/drawer_package" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#E9E1FF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/project_structure" style="@style/Cosmic.Muted" />
            <ImageView android:id="@+id/tree_upload" style="@style/Cosmic.IconButton" android:src="@drawable/ic_upload"
                android:tint="@color/cosmic_ink" android:contentDescription="@null" />
            <ImageView android:id="@+id/tree_add_file" style="@style/Cosmic.IconButton" android:src="@drawable/ic_note_add"
                android:tint="@color/cosmic_ink" android:contentDescription="@null" />
            <ImageView android:id="@+id/tree_add_folder" style="@style/Cosmic.IconButton" android:src="@drawable/ic_create_folder"
                android:tint="@color/cosmic_ink" android:contentDescription="@null" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/tree_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cosmic_lilac" />
        <LinearLayout android:id="@+id/drawer_all_projects" android:layout_width="match_parent" android:layout_height="64dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="24dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_grid"
                android:tint="@color/cosmic_primary" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                android:text="@string/all_projects" android:textColor="@color/cosmic_ink" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
