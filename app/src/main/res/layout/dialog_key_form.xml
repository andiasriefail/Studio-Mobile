<?xml version="1.0" encoding="utf-8"?>
<!-- Everything (message, fields and the Cancel / Change Key buttons) lives inside ONE scroll area, so on a short window
     or with the keyboard open the buttons can always be scrolled into view and tapped. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:scrollbars="vertical" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/form_message" style="@style/Cosmic.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <EditText android:id="@+id/form_alias" style="@style/Cosmic.Input" android:layout_marginTop="0dp" android:autofillHints="@null"
        android:hint="@string/keystore_alias" android:inputType="text" />
    <EditText android:id="@+id/form_password" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/keystore_password" android:inputType="textPassword" />
    <EditText android:id="@+id/form_password_confirm" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_password_confirm" android:inputType="textPassword" />
    <EditText android:id="@+id/form_company" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_company" android:inputType="textPersonName|textCapWords" />
    <EditText android:id="@+id/form_organization" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_organization" android:inputType="textCapWords" />
    <EditText android:id="@+id/form_unit" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_unit" android:inputType="textCapWords" />
    <EditText android:id="@+id/form_city" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_city" android:inputType="textCapWords" />
    <EditText android:id="@+id/form_state" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_state" android:inputType="textCapWords" />
    <EditText android:id="@+id/form_country" style="@style/Cosmic.Input" android:layout_marginTop="12dp" android:autofillHints="@null"
        android:hint="@string/key_form_country" android:inputType="textCapCharacters" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:orientation="horizontal" android:gravity="end">
        <Button android:id="@+id/form_cancel" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/cancel" />
        <Button android:id="@+id/form_confirm" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
